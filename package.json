{
  "name": "@firatkill/outbox",
  "version": "0.0.0",
  "description": "Transactional outbox, relay and inbox for PostgreSQL. At-least-once delivery with leases, retries, dead letters and per-key ordering.",
  "license": "MIT",
  "author": "Fırat Kıl",
  "homepage": "https://outbox.firatkil.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatkill/outbox.git"
  },
  "bugs": {
    "url": "https://github.com/firatkill/outbox/issues"
  },
  "keywords": [
    "outbox",
    "transactional-outbox",
    "postgres",
    "postgresql",
    "relay",
    "inbox",
    "idempotency",
    "at-least-once",
    "skip-locked",
    "bullmq",
    "webhook"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.18.3",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./postgres-js": {
      "import": {
        "types": "./dist/postgres-js.d.ts",
        "default": "./dist/postgres-js.js"
      },
      "require": {
        "types": "./dist/postgres-js.d.cts",
        "default": "./dist/postgres-js.cjs"
      }
    },
    "./pg": {
      "import": {
        "types": "./dist/pg.d.ts",
        "default": "./dist/pg.js"
      },
      "require": {
        "types": "./dist/pg.d.cts",
        "default": "./dist/pg.cjs"
      }
    },
    "./bullmq": {
      "import": {
        "types": "./dist/bullmq.d.ts",
        "default": "./dist/bullmq.js"
      },
      "require": {
        "types": "./dist/bullmq.d.cts",
        "default": "./dist/bullmq.cjs"
      }
    },
    "./webhook": {
      "import": {
        "types": "./dist/webhook.d.ts",
        "default": "./dist/webhook.js"
      },
      "require": {
        "types": "./dist/webhook.d.cts",
        "default": "./dist/webhook.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "bin": {
    "outbox": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "pg": "^8.11.0",
    "postgres": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "chaos": "tsx scripts/chaos/run.ts",
    "bench": "tsx scripts/bench/run.ts",
    "bench:readme": "tsx scripts/bench/readme.ts",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:up:all": "docker compose --profile matrix up -d --wait",
    "db:down": "docker compose --profile matrix down -v",
    "db:psql": "docker compose exec postgres psql -U postgres -d outbox_test",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "check:guards": "tsx scripts/check-guards.ts",
    "size": "size-limit",
    "docs:api": "typedoc",
    "docs:check": "tsx scripts/docs-check.ts",
    "docs:dev": "pnpm docs:api && vitepress dev site",
    "docs:build": "pnpm docs:api && vitepress build site",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "prepublishOnly": "pnpm build && pnpm check:package"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsdown": "0.23.1",
    "vitest": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "typescript-eslint": "8.72.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "@types/node": "22.20.5",
    "postgres": "3.4.9",
    "pg": "8.23.1",
    "@types/pg": "8.23.1",
    "publint": "0.3.25",
    "@arethetypeswrong/cli": "0.18.5",
    "size-limit": "14.2.0",
    "@size-limit/preset-small-lib": "14.2.0",
    "@changesets/cli": "2.31.1",
    "@changesets/changelog-github": "1.0.1"
  }
}
